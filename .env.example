# Required for production
DATABASE_URL="postgresql://postgres:password@localhost:5432/ruwaq?schema=public"
AUTH_SECRET=""  # openssl rand -base64 32
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (optional — sign-in only works when set)
# Coolify / production:
#   AUTH_URL=https://ruwaq.co
#   Authorized redirect URI in Google Cloud Console:
#   https://ruwaq.co/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Alternate names also supported:
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Google Gemini — Nano Banana (recommended for interior / exterior / booth photo edits)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"

# OpenAI — fallback when Gemini is not set
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="gpt-image-1.5"

# Design studio credits — while BILLING_ENABLED=false, generations are unlimited.
# Set DESIGN_CREDITS_UNLIMITED=false to enforce the 3-credit cap before launch billing.
DESIGN_CREDITS_UNLIMITED=""

# App display name
NEXT_PUBLIC_APP_NAME="Ruwaq"

# Emails allowed to view /admin/metrics (comma-separated). No external
# analytics account needed — this reads directly from the UsageEvent table.
ADMIN_EMAILS="radwan3@gmail.com"

# Pre-launch password gate (HTTP Basic Auth — entire site when password is set)
# Leave APP_GATE_PASSWORD empty in local dev to disable.
APP_GATE_USER="ruwaq"
APP_GATE_PASSWORD=""
# true = lock homepage + marketing too (default). false = only dashboard/API gated.
APP_GATE_FULL_SITE="false"

# Premium-templates paywall master switch. "false" = free launch trial —
# every export template is unlocked for everyone, nothing to configure.
# Flip to "true" whenever you're ready to start charging (suggested:
# ~1 month after launch, once people know the product). No redeploy of
# code needed — the PayPal flow below is already wired and just activates.
BILLING_ENABLED="false"

# PayPal — temporary payment rail for premium templates unlock (2026-07-02).
# USD only (PayPal does not settle in SAR). Only matters once
# BILLING_ENABLED="true". Sandbox app: https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
# sandbox | live
PAYPAL_ENV="sandbox"

# Cloud storage (Cloudflare R2 or AWS S3) for company logo uploads.
# Leave empty to fall back to local disk (fine for local dev only — on
# Coolify/most PaaS hosts local uploads are lost on the next redeploy).
# R2: create a bucket + API token at https://dash.cloudflare.com/?to=/:account/r2
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""
# R2 example: https://<account_id>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=""
# "auto" for R2; a real region (e.g. "me-central-1") for AWS S3.
STORAGE_REGION="auto"
# Public base URL objects are served from — R2 custom domain, r2.dev URL,
# or a CDN in front of the bucket. Falls back to "{STORAGE_ENDPOINT}/{STORAGE_BUCKET}".
STORAGE_PUBLIC_URL=""

# Turriva lead capture (fit-out + contracting) — optional webhook JSON POST
TURRIVA_LEAD_WEBHOOK_URL=""
# Email to Turriva sales when fit-out/contracting leads arrive (requires Resend)
TURRIVA_LEAD_EMAIL=""
# Ruwaq ops inbox — all marketplace + join leads (defaults to hello@ruwaq.co)
RUWQ_LEAD_EMAIL=""
RESEND_API_KEY=""
RESEND_FROM="Ruwaq Leads <hello@ruwaq.co>"
# Google Analytics 4 — optional; enables page views + conversion events
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# Client WhatsApp follow-up button after quote submit (E.164, e.g. +9665xxxxxxxx)
RUWQ_SUPPORT_WHATSAPP=""
# Public copy for contact page (can match RUWQ_SUPPORT_WHATSAPP)
NEXT_PUBLIC_RUWQ_SUPPORT_WHATSAPP=""
# Optional webhook when leads broadcast to partners (hvac, elevators, …)
PARTNER_LEAD_WEBHOOK_URL=""
# Graphics House visualization leads (PartnerLead from /visualization and request-quote)
GRAPHICS_HOUSE_LEAD_EMAIL=""
GRAPHICS_HOUSE_LEAD_WEBHOOK_URL=""
